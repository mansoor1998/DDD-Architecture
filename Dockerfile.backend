FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered stdout/stderr (better for docker logs)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /code

# Install requirements first (better layer caching — only re-runs pip install if requirements.txt changes)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

# --- Application configuration (matches app/core/config.py) ---
# These become environment variables inside the container and are picked up
# automatically by Pydantic BaseSettings (field name -> env var name).
# Override any of these at runtime, e.g.:
#   docker run -e SECRET_KEY=prod-secret -e DATABASE_URL=postgresql+asyncpg://... myimage
# or via a docker-compose "env_file: .env" / "environment:" block.
ENV DATABASE_URL="sqlite+aiosqlite:///./sql_app.db" \
    SECRET_KEY="a_very_secret_key" \
    ALGORITHM="HS256" \
    ACCESS_TOKEN_EXPIRE_MINUTES=30 \
    SMTP_SERVER="smtp.gmail.com" \
    SMTP_PORT=587 \
    SMTP_USERNAME="" \
    SMTP_PASSWORD=""

EXPOSE 8000

# No --reload in production images; use it only by overriding CMD for local dev.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]